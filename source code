  function loadAdminUsers(){ const users=JSON.parse(localStorage.getItem(KEYS.users)||'[]'); const c=document.getElementById('adminUsersList'); if(!c) return; if(!users.length) c.innerHTML='No registered users'; else c.innerHTML = users.map(u=> `<div style="padding:8px;border-bottom:1px solid #eee;">${escapeHtml(u.name)} • ${escapeHtml(u.email)}</div>`).join(''); }
  function loadAdminTrips(){ const trips=JSON.parse(localStorage.getItem(KEYS.trips)||'[]'); const c=document.getElementById('adminTripsList'); if(!c) return; if(!trips.length) c.innerHTML='No trips created'; else c.innerHTML = trips.map(t=> `<div style="padding:8px;border-bottom:1px solid #eee;"><strong>${escapeHtml(t.title||t.dest||'Trip')}</strong> • ${escapeHtml(t.created||'')}</div>`).join(''); }
  function loadAdminMessages(){ const msgs=JSON.parse(localStorage.getItem(KEYS.messages)||'[]'); const c=document.getElementById('adminMessagesList'); if(!c) return; if(!msgs.length) c.innerHTML='No messages'; else c.innerHTML = msgs.map(m=> `<div style="padding:8px;border-bottom:1px solid #eee;"><strong>${escapeHtml(m.name)}</strong> (${escapeHtml(m.email)})<br>${escapeHtml(m.subject)} — ${escapeHtml(m.message)}</div>`).join(''); }
  function clearDemoData(){ if(!confirm('Clear demo data (users, trips, messages)?')) return; localStorage.removeItem(KEYS.users); localStorage.removeItem(KEYS.trips); localStorage.removeItem(KEYS.messages); localStorage.removeItem(KEYS.listings); alert('Demo data cleared'); loadAdminUsers(); loadAdminTrips(); loadAdminMessages(); }

  function scrollToSection(id){ const el=document.getElementById(id); if(!el){ window.scrollTo({top:0, behavior:'smooth'}); return; } const top = el.getBoundingClientRect().top + window.scrollY - 80; window.scrollTo({ top, behavior:'smooth' }); const sb=document.getElementById('sidebar'); if(sb && sb.classList.contains('open')) sb.classList.remove('open'); }

  // initialize on load
  document.addEventListener('DOMContentLoaded', ()=>{
    seedListings();
    populateInterestGrid(); populateExperienceGrid(); populateIconics();
    renderListings('hotelsGrid','hotel'); renderListings('restaurantsGrid','restaurant'); renderListings('thingsGrid','activity');
    loadSavedTrips();
    initIMR();
    const genBtn = document.getElementById('genTripBtn'); if(genBtn) genBtn.addEventListener('click', generateTrip);
    setTimeout(()=> { if(typeof imrMap !== 'undefined' && imrMap) imrMap.invalidateSize(); }, 500);
    // ensure admin lists visible
    loadAdminUsers(); loadAdminTrips(); loadAdminMessages();
  });

  // expose for debugging (optional)
  window.generateTrip = generateTrip;
  window.createTripFromHome = createTripFromHome;
  window.addIMRPoint = addIMRPoint;
  window.openLogin = openLogin;
  window.openRegister = openRegister;
  window.scrollToSection = scrollToSection;
  </script>

</body>
</html>
