  async function callGuideAI(payload){
    const endpoint = '/api/guide360-ai';
    try{
      const res = await fetch(endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      if(!res.ok){
        const txt = await res.text(); throw new Error('AI endpoint error: ' + txt);
      }
      const data = await res.json();
      return data;
    }catch(err){
      throw err;
    }
  }

  function localAIGenerate(dest, start, end, mood, pax){
    const all = getListings();
    let picks = all.filter(x=> x.city.toLowerCase().includes((dest||'').toLowerCase()));
    if(picks.length < 4) picks = picks.concat(all.slice(0,5));
    picks = picks.slice(0,6);
    const base = picks.reduce((s,c)=> s + (c.price||1000), 0);
    let mult = 1;
    if(mood==='luxury') mult = 2;
    if(mood==='adventure') mult = 1.3;
    if(mood==='food') mult = 1.15;
    const budget = Math.round(base * mult);
    return { id: uid('trip'), title: dest + ' Trip', dest, summary: `A ${mood} trip for ${pax}`, budgetEstimate: budget, picks, itinerary: [{day:'Day 1', items:picks.slice(0,3)}], created: new Date().toLocaleString() };
  }

  async function generateTrip(event){
