<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Guide360 — Final Merged</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- AOS -->
  <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">

  <!-- Leaflet -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <style>
  /* -------------------------
     GUIDE360 — merged styles
     Mobile-first, responsive
     ------------------------- */
  :root{
    --bg:#f6f8fb; --card:#ffffff; --muted:#6b7280; 
    --accent:#0ea5a4; --accent-dark:#0b8b85; --radius:12px;
  }
  [data-theme="dark"]{ --bg:#071227; --card:#0b1220; --muted:#9aa4b2; --accent:#2dd4bf; color-scheme:dark; }

  *{box-sizing:border-box}
  html,body{height:100%; margin:0; padding:0; font-family:Inter, system-ui, "Segoe UI", Roboto, Arial; background:var(--bg); color:#071227; -webkit-font-smoothing:antialiased;}
  a{color:inherit; text-decoration:none}

  .container-wide{width:min(95%,1200px); margin:0 auto; padding:18px;}

  .sidebar{
    width:260px; background:linear-gradient(180deg,#062f2c,#0a5a56); color:white; position:fixed; top:0; left:0; bottom:0; padding:18px; overflow:auto; z-index:1200; transition:transform .22s ease;
  }
  .sidebar .logo{display:flex; gap:12px; align-items:center; margin-bottom:14px}
  .sidebar img{width:44px;height:44px;border-radius:8px;object-fit:cover}
  .menu-item{padding:10px;border-radius:8px;margin-bottom:8px;cursor:pointer;display:flex;gap:10px;align-items:center}
  .menu-item:hover{background:rgba(255,255,255,0.06); transform:translateX(6px)}
  .menu-small{font-size:.95rem;opacity:.95}

  .main{margin-left:260px; padding:18px 18px 80px 18px; transition:margin .22s}
  @media (max-width:992px){ .sidebar{transform:translateX(-110%)} .sidebar.open{transform:translateX(0)} .main{margin-left:0} }

  .hero{background-image:url('https://images.pexels.com/photos/346885/pexels-photo-346885.jpeg'); background-size:cover; background-position:center; border-radius:var(--radius); padding:26px; color:#fff; position:relative; overflow:hidden;}
  .hero-overlay{background:linear-gradient(180deg, rgba(0,0,0,0.45), rgba(0,0,0,0.25)); padding:18px; border-radius:var(--radius);}

  .search-card{background:rgba(255,255,255,0.06); padding:12px; border-radius:10px; display:flex; gap:8px; flex-wrap:wrap; align-items:center}
  .search-card input, .search-card select{min-width:140px; flex:1 1 160px}

  .grid { display:grid; gap:12px; }
  .grid-4{ grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); }
  .grid-3{ grid-template-columns: repeat(auto-fit, minmax(240px,1fr)); }
  .grid-2{ grid-template-columns: repeat(auto-fit, minmax(300px,1fr)); }

  @media (max-width:1200px){ .grid-4{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))} }
  @media (max-width:900px){ .grid-4{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))} .grid-3{grid-template-columns:repeat(2,1fr)} }
  @media (max-width:600px){ .grid-4,.grid-3,.grid-2{grid-template-columns:1fr} .hero{padding:16px} }

  .card{ background:var(--card); border-radius:var(--radius); padding:12px; box-shadow:0 6px 20px rgba(2,6,23,0.06); overflow:hidden; }
  .small-muted{ color:var(--muted); font-size:.95rem; }

  .places-row{ display:flex; gap:12px; overflow-x:auto; padding-bottom:8px }
  .place-pill{ min-width:180px; border-radius:10px; overflow:hidden; background:var(--card); box-shadow:0 6px 18px rgba(2,6,23,0.06) }
  .place-pill img{ width:100%; height:110px; object-fit:cover }

  .collection img{ width:100%; height:140px; object-fit:cover; border-radius:8px }

  #imrMap{ width:100%; height:clamp(300px,50vw,520px); border-radius:10px }

  footer .card{ background:#071227; color:#fff }

  .btn-accent{ background:var(--accent); color:#fff; border:0 }

  button:focus, input:focus, select:focus{ outline:3px solid rgba(14,165,164,0.16); outline-offset:2px }

  img{ max-width:100%; height:auto; display:block }

  .badge-ai{ background:linear-gradient(90deg,#06b6d4,#06b6b7); color:#fff; padding:6px 10px; border-radius:999px; font-weight:700 }

  .imr-popup{ position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); display:none; align-items:center; justify-content:center; z-index:99999; }
  .imr-popup-content{ background:white; padding:16px; border-radius:10px; width:320px; text-align:center; }
  .imr-popup-buttons button{ width:90px; }

  /* small responsive tweaks */
  .table-sm td, .table-sm th { padding: .45rem; font-size: .9rem; }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="logo">
      <img src="https://images.pexels.com/photos/21014/pexels-photo.jpg" alt="Guide360 logo">
      <div>
        <div style="font-weight:800; font-size:1.05rem;">Guide<span style="color:#2dd4bf">360</span></div>
        <div class="small-muted">Travel Assistant</div>
      </div>
    </div>

    <div class="menu-item" onclick="scrollToSection('home')"><i class="fa-solid fa-house"></i>&nbsp;<span class="menu-small">Home</span></div>
    <div class="menu-item" onclick="scrollToSection('discover')"><i class="fa-solid fa-compass"></i>&nbsp;<span class="menu-small">Discover</span></div>
    <div class="menu-item" onclick="scrollToSection('hotels')"><i class="fa-solid fa-hotel"></i>&nbsp;<span class="menu-small">Hotels</span></div>
    <div class="menu-item" onclick="scrollToSection('restaurants')"><i class="fa-solid fa-utensils"></i>&nbsp;<span class="menu-small">Restaurants</span></div>
    <div class="menu-item" onclick="scrollToSection('things')"><i class="fa-solid fa-map-location-dot"></i>&nbsp;<span class="menu-small">Things to Do</span></div>
    <div class="menu-item" onclick="scrollToSection('trips')"><i class="fa-solid fa-suitcase-rolling"></i>&nbsp;<span class="menu-small">Trips</span></div>
    <div class="menu-item" onclick="scrollToSection('imr')"><i class="fa-solid fa-route"></i>&nbsp;<span class="menu-small">IMR</span></div>

    <hr style="border-color:rgba(255,255,255,0.12)">

    <div class="menu-item" onclick="scrollToSection('about')"><i class="fa-solid fa-circle-info"></i>&nbsp;<span class="menu-small">About</span></div>
    <div class="menu-item" onclick="scrollToSection('contact')"><i class="fa-solid fa-envelope"></i>&nbsp;<span class="menu-small">Contact</span></div>

    <div style="margin-top:16px;">
      <div class="small-muted">Account</div>
      <div style="display:flex; gap:8px; margin-top:8px;">
        <button class="btn btn-sm btn-light" onclick="openLogin()">Login</button>
        <button class="btn btn-sm btn-outline-light" onclick="openRegister()">Register</button>
      </div>
    </div>

    <div style="height:28px;"></div>
    <div class="small-muted">Guide360 — Final Demo</div>
  </aside>

  <!-- MAIN -->
  <main class="main">

    <!-- Mobile menu toggle -->
    <button class="btn btn-dark d-lg-none mb-3" onclick="document.getElementById('sidebar').classList.toggle('open')" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>

    <!-- HOME HERO -->
    <section id="home" data-aos="fade-up">
      <div class="hero">
        <div class="hero-overlay">
          <h1 style="margin:0; font-size:clamp(1.4rem,4vw,2rem);">Where to? <span class="small-muted" style="font-weight:600; font-size:.95rem;">Create a trip with AI assistance</span></h1>
          <p class="small-muted" style="margin-top:6px;">Select destination, dates and travel type — then click Create Trip.</p>

          <div class="search-card mt-3" role="search" aria-label="Trip search">
            <input id="homeDest" type="text" class="form-control" placeholder="City or Country (e.g., Goa)">
            <input id="homeStart" type="date" class="form-control" style="max-width:180px">
            <input id="homeEnd" type="date" class="form-control" style="max-width:180px">
            <select id="homePax" class="form-select" style="max-width:150px">
              <option value="solo">Solo</option>
              <option value="partner">Partner</option>
              <option value="family">Family</option>
              <option value="friends">Friends</option>
            </select>
            <button class="btn btn-accent" type="button" onclick="createTripFromHome()">
              <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Create Trip
            </button>
          </div>

          <div class="d-flex gap-2 mt-3 align-items-center">
            <div class="badge-ai">AI</div>
            <div class="small-muted">Powered suggestions · Budget planning · Top picks</div>
          </div>
        </div>

        <!-- hero carousel -->
        <div class="mt-3">
          <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" style="border-radius:10px; overflow:hidden;">
            <div class="carousel-inner">
              <div class="carousel-item active"><img src="https://images.pexels.com/photos/338504/pexels-photo-338504.jpeg" style="width:100%; height:220px; object-fit:cover;"></div>
              <div class="carousel-item"><img src="https://images.pexels.com/photos/261102/pexels-photo-261102.jpeg" style="width:100%; height:220px; object-fit:cover;"></div>
              <div class="carousel-item"><img src="https://images.pexels.com/photos/3601453/pexels-photo-3601453.jpeg" style="width:100%; height:220px; object-fit:cover;"></div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- DISCOVER -->
    <section id="discover" class="mt-4" data-aos="fade-up">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h3 style="margin:0">Discover</h3>
          <div class="small-muted">Collections, trending cities & activities</div>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-secondary btn-sm" onclick="scrollToSection('hotels')">Hotels</button>
          <button class="btn btn-outline-secondary btn-sm" onclick="scrollToSection('restaurants')">Restaurants</button>
          <button class="btn btn-outline-secondary btn-sm" onclick="scrollToSection('things')">Activities</button>
        </div>
      </div>

      <div class="card mt-3 p-3">
        <h5>Find things by interest</h5>
        <div class="grid grid-4 mt-3" id="interestGrid"></div>
      </div>

      <div class="card mt-3 p-3">
        <h5>Experience — We think you'll love</h5>
        <div class="grid grid-3 mt-3" id="experienceGrid"></div>
      </div>

      <div class="card mt-3 p-3">
        <h5>Iconic places — India & Worldwide</h5>
        <div class="places-row mt-2" id="iconicRow"></div>
      </div>

      <div class="card mt-3 p-3">
        <h5>Browse themed collections</h5>
        <div class="row mt-3">
          <div class="col-md-4"><div class="collection card"><img src="https://images.pexels.com/photos/459225/pexels-photo-459225.jpeg"><div style="padding:8px;"><strong>Winter Escapes</strong><div class="small-muted">Snow & cozy stays</div></div></div></div>
          <div class="col-md-4"><div class="collection card"><img src="https://images.pexels.com/photos/159866/sand-summer-beach-boat-159866.jpeg"><div style="padding:8px;"><strong>Summer Sun</strong><div class="small-muted">Beaches & festivals</div></div></div></div>
          <div class="col-md-4"><div class="collection card"><img src="https://images.pexels.com/photos/666806/pexels-photo-666806.jpeg"><div style="padding:8px;"><strong>Monsoon Trips</strong><div class="small-muted">Green & off-season</div></div></div></div>
        </div>
      </div>
    </section>

    <!-- HOTELS -->
    <section id="hotels" class="mt-4" data-aos="fade-up">
      <h3>Hotels</h3>
      <div class="card mt-2 p-3">
        <div class="d-flex gap-2 flex-wrap align-items-center">
          <input id="hotelSearch" class="form-control" placeholder="Search hotels or city" style="max-width:420px;">
          <select id="hotelSort" class="form-select" style="max-width:180px;">
            <option value="popular">Popular</option>
            <option value="price_low">Price low → high</option>
            <option value="price_high">Price high → low</option>
          </select>
          <button class="btn btn-accent" onclick="applyHotelSearch()">Search</button>
        </div>

        <div id="hotelsGrid" class="grid grid-4 mt-3"></div>
      </div>
    </section>

    <!-- RESTAURANTS -->
    <section id="restaurants" class="mt-4" data-aos="fade-up">
      <h3>Restaurants</h3>
      <div class="card mt-2 p-3">
        <div class="d-flex gap-2 align-items-center">
          <input id="restSearch" class="form-control" placeholder="Search restaurants or cuisine" style="max-width:420px;">
          <select id="restFilter" class="form-select" style="max-width:180px;">
            <option value="all">All</option>
            <option value="street">Street</option>
            <option value="fine">Fine dining</option>
          </select>
          <button class="btn btn-accent" onclick="applyRestSearch()">Search</button>
        </div>

        <div id="restaurantsGrid" class="grid grid-4 mt-3"></div>
      </div>
    </section>

    <!-- THINGS TO DO -->
    <section id="things" class="mt-4" data-aos="fade-up">
      <h3>Things to do</h3>
      <div class="card mt-2 p-3">
        <div class="d-flex gap-2 align-items-center">
          <input id="thingsSearch" class="form-control" placeholder="Search activities or city" style="max-width:420px;">
          <select id="thingsFilter" class="form-select" style="max-width:180px;">
            <option value="all">All</option>
            <option value="adventure">Adventure</option>
            <option value="culture">Culture</option>
            <option value="relax">Relax</option>
          </select>
          <button class="btn btn-accent" onclick="applyThingsSearch()">Search</button>
        </div>

        <div id="thingsGrid" class="grid grid-4 mt-3"></div>
      </div>
    </section>

    <!-- TRIPS: AI Trip Builder -->
    <section id="trips" class="mt-4" data-aos="fade-up">
      <h3>Create Trip — Powered by AI</h3>
      <div class="card mt-2 p-3">
        <form id="aiTripForm" onsubmit="return false;">
          <div class="row g-2">
            <div class="col-sm-6 col-md-4"><input name="dest" class="form-control" placeholder="Destination (e.g., Goa)"></div>
            <div class="col-sm-6 col-md-2"><input name="start" type="date" class="form-control"></div>
            <div class="col-sm-6 col-md-2"><input name="end" type="date" class="form-control"></div>
            <div class="col-sm-6 col-md-2"><select name="mood" class="form-select"><option value="relax">Relax</option><option value="adventure">Adventure</option><option value="culture">Culture</option><option value="food">Food</option><option value="luxury">Luxury</option></select></div>
            <div class="col-12 col-md-2"><button class="btn btn-accent w-100" id="genTripBtn">Generate Trip</button></div>
          </div>
        </form>
      </div>

      <div id="aiTripResult" class="mt-3"></div>

      <div class="card mt-3 p-3">
        <h5>My Saved Trips</h5>
        <div id="savedTripsList"></div>
      </div>
    </section>

    <!-- IMR Map -->
    <section id="imr" class="mt-4" data-aos="fade-up">
      <h3>Instant Map Routes (IMR)</h3>
      <div class="card mt-2 p-3">
        <div class="row g-2">
          <div class="col-sm-8 col-md-8"><input id="imrPlaceSearch" class="form-control" placeholder="Search location (e.g., Taj Mahal)"></div>
          <div class="col-sm-4 col-md-4"><button class="btn btn-accent w-100" onclick="searchPlaceIMR()">Search & Add</button></div>
        </div>

        <div id="imrMap" class="mt-3"></div>

        <div class="d-flex gap-2 mt-3 flex-wrap align-items-center">
          <div class="small-muted">Choose a segment on the map to override mode, or let auto-assign pick it for you.</div>
          <button class="btn btn-danger ms-auto" onclick="clearIMRMap()">Clear Map</button>
        </div>

        <div id="imrSegments" class="mt-3"></div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="mt-4" data-aos="fade-up">
      <h3>Contact</h3>
      <div class="card mt-2 p-3" style="max-width:920px;">
        <div class="row g-2">
          <div class="col-md-4"><input id="contactName" class="form-control" placeholder="Name"></div>
          <div class="col-md-4"><input id="contactEmail" class="form-control" placeholder="Email"></div>
          <div class="col-md-4"><input id="contactSubject" class="form-control" placeholder="Subject"></div>
        </div>
        <div style="margin-top:10px;"><textarea id="contactMessage" class="form-control" rows="4" placeholder="Message"></textarea></div>
        <div style="margin-top:10px;"><button class="btn btn-accent" onclick="sendContact()">Send Message</button></div>
        <div id="contactMsg" class="small-muted mt-2"></div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="mt-4" data-aos="fade-up">
      <h3>About Guide360</h3>
      <div class="card mt-2 p-3">
        <p class="small-muted">Guide360 is a demo travel assistant built to show multi-mode routing, AI trip suggestions, and responsive UI. Use it as a starter for production apps.</p>
      </div>
    </section>

    <!-- ADMIN -->
    <section id="admin" class="mt-4" data-aos="fade-up">
      <h3>Admin</h3>
      <div class="card mt-2 p-3">
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <button class="btn btn-outline-secondary" onclick="loadAdminUsers()">Load Users</button>
          <button class="btn btn-outline-secondary" onclick="loadAdminTrips()">Load Trips</button>
          <button class="btn btn-outline-secondary" onclick="loadAdminMessages()">Load Messages</button>
          <button class="btn btn-danger" onclick="clearDemoData()">Clear Demo Data</button>
        </div>
        <div id="adminUsersList" class="mt-3 small-muted"></div>
        <div id="adminTripsList" class="mt-3 small-muted"></div>
        <div id="adminMessagesList" class="mt-3 small-muted"></div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="mt-4">
      <div class="card p-3">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;">
          <div><strong>Guide360</strong> <div class="small-muted">Plan, save & share trips worldwide</div></div>
          <div><a href="#about" onclick="scrollToSection('about')">About</a> &nbsp; • &nbsp; <a href="#contact" onclick="scrollToSection('contact')">Contact</a></div>
          <div class="small-muted">© Guide360 — Demo</div>
        </div>
      </div>
    </footer>

  </main>

  <!-- LOGIN / REGISTER MODAL -->
  <div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header"><h5 id="authTitle">Login</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <form id="authForm" onsubmit="return false;">
            <div class="mb-2"><input id="authName" class="form-control" placeholder="Full name (for register)"></div>
            <div class="mb-2"><input id="authEmail" class="form-control" placeholder="Email"></div>
            <div class="mb-2"><input id="authPass" type="password" class="form-control" placeholder="Password"></div>
            <div class="d-flex justify-content-end gap-2">
              <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
              <button class="btn btn-accent" id="authActionBtn">Login</button>
            </div>
            <div id="authMsg" class="small-muted mt-2"></div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- POPUP FOR SELECTING MODE -->
  <div id="imrModePopup" class="imr-popup">
    <div class="imr-popup-content">
      <h6>Select Travel Mode</h6>
      <div id="imrModeButtons" class="imr-popup-buttons"></div>
      <button class="btn btn-sm btn-outline-danger mt-2" onclick="closeModePopup()">Close</button>
    </div>
  </div>

  <!-- SCRIPTS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
  // ============================
  // GUIDE360 — Full merged JS
  // ============================

  AOS.init({ duration: 700, once: true });

  // storage keys
  const KEYS = {
    listings: 'g360_listings',
    trips: 'g360_aiTrips',
    users: 'g360_users',
    messages: 'g360_messages',
    tempTrip: 'g360_tempTrip'
  };

  // helpers
  function uid(prefix='id'){ return prefix + '_' + Math.random().toString(36).slice(2,9); }
  function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }

  // seed sample listings
  function seedListings(){
    if(localStorage.getItem(KEYS.listings)) return;
    const sample = [
      {id:'l1', type:'hotel', title:'The Grand Palace Hotel', city:'Goa', price:5000, img:'https://images.pexels.com/photos/261102/pexels-photo-261102.jpeg', desc:'Beachfront luxury'},
      {id:'l2', type:'hotel', title:'Hilltop Resort', city:'Shillong', price:4200, img:'https://images.pexels.com/photos/356844/pexels-photo-356844.jpeg', desc:'Nature stay'},
      {id:'l3', type:'restaurant', title:'Cafe Delights', city:'Bengaluru', price:800, img:'https://images.pexels.com/photos/70497/pexels-photo-70497.jpeg', desc:'Local favorites'},
      {id:'l4', type:'activity', title:'River Kayaking', city:'Kashmir', price:2500, img:'https://images.pexels.com/photos/164595/pexels-photo-164595.jpeg', desc:'Guided rafting'},
      {id:'l5', type:'restaurant', title:'Street Food Market', city:'Delhi', price:300, img:'https://images.pexels.com/photos/262047/pexels-photo-262047.jpeg', desc:'Tasty local eats'},
      {id:'l6', type:'activity', title:'City Museum Tour', city:'Paris', price:1200, img:'https://images.pexels.com/photos/21014/pexels-photo.jpg', desc:'Guided cultural tour'},
      {id:'l7', type:'hotel', title:'Budget Stay Inn', city:'Pondicherry', price:1800, img:'https://images.pexels.com/photos/753626/pexels-photo-753626.jpeg', desc:'Cozy rooms'},
      {id:'l8', type:'activity', title:'Sunset Cruise', city:'Maldives', price:7000, img:'https://images.pexels.com/photos/3601453/pexels-photo-3601453.jpeg', desc:'Luxury sunset cruise'}
    ];
    localStorage.setItem(KEYS.listings, JSON.stringify(sample));
  }

  function getListings(){ return JSON.parse(localStorage.getItem(KEYS.listings) || '[]'); }

  // populate discover sections
  function populateInterestGrid(){
    const items = [
      {title:'Outdoors', img:'https://images.pexels.com/photos/346885/pexels-photo-346885.jpeg', desc:'Hiking, parks & trails'},
