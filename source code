<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Guide360 — 100x Hackathon Edition</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- AOS -->
  <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">

  <!-- Leaflet -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <style>
  /* -------------------------
     GUIDE360 — 100x Edition
     Mobile-first, responsive
     ------------------------- */
  :root{
    --bg:#f6f8fb; --card:#ffffff; --muted:#6b7280; 
    --accent:#0ea5a4; --accent-dark:#0b8b85; --radius:12px;
    --success:#10b981; --danger:#ef4444;
  }
  [data-theme="dark"]{ --bg:#071227; --card:#0b1220; --muted:#9aa4b2; --accent:#2dd4bf; color-scheme:dark; }

  *{box-sizing:border-box}
  html,body{height:100%; margin:0; padding:0; font-family:Inter, system-ui, "Segoe UI", Roboto, Arial; background:var(--bg); color:#071227; -webkit-font-smoothing:antialiased;}
  a{color:inherit; text-decoration:none}

  .container-wide{width:min(95%,1200px); margin:0 auto; padding:18px;}

  .sidebar{
    width:260px; background:linear-gradient(180deg,#062f2c,#0a5a56); color:white; position:fixed; top:0; left:0; bottom:0; padding:18px; overflow:auto; z-index:1200; transition:transform .22s ease;
  }
  .sidebar .logo{display:flex; gap:12px; align-items:center; margin-bottom:14px}
  .sidebar img{width:44px;height:44px;border-radius:8px;object-fit:cover}
  .menu-item{padding:10px;border-radius:8px;margin-bottom:8px;cursor:pointer;display:flex;gap:10px;align-items:center}
  .menu-item:hover{background:rgba(255,255,255,0.06); transform:translateX(6px)}
  .menu-small{font-size:.95rem;opacity:.95}

  .main{margin-left:260px; padding:18px 18px 80px 18px; transition:margin .22s}
  @media (max-width:992px){ .sidebar{transform:translateX(-110%)} .sidebar.open{transform:translateX(0)} .main{margin-left:0} }

  .hero{background-image:url('https://images.pexels.com/photos/346885/pexels-photo-346885.jpeg'); background-size:cover; background-position:center; border-radius:var(--radius); padding:26px; color:#fff; position:relative; overflow:hidden;}
  .hero-overlay{background:linear-gradient(180deg, rgba(0,0,0,0.45), rgba(0,0,0,0.25)); padding:18px; border-radius:var(--radius);}

  .search-card{background:rgba(255,255,255,0.06); padding:12px; border-radius:10px; display:flex; gap:8px; flex-wrap:wrap; align-items:center}
  .search-card input, .search-card select{min-width:140px; flex:1 1 160px}

  .grid { display:grid; gap:12px; }
  .grid-4{ grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); }
  .grid-3{ grid-template-columns: repeat(auto-fit, minmax(240px,1fr)); }
  .grid-2{ grid-template-columns: repeat(auto-fit, minmax(300px,1fr)); }

  @media (max-width:1200px){ .grid-4{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))} }
  @media (max-width:900px){ .grid-4{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))} .grid-3{grid-template-columns:repeat(2,1fr)} }
  @media (max-width:600px){ .grid-4,.grid-3,.grid-2{grid-template-columns:1fr} .hero{padding:16px} }

  .card{ background:var(--card); border-radius:var(--radius); padding:12px; box-shadow:0 6px 20px rgba(2,6,23,0.06); overflow:hidden; }
  .small-muted{ color:var(--muted); font-size:.95rem; }

  .places-row{ display:flex; gap:12px; overflow-x:auto; padding-bottom:8px }
  .place-pill{ min-width:180px; border-radius:10px; overflow:hidden; background:var(--card); box-shadow:0 6px 18px rgba(2,6,23,0.06) }
  .place-pill img{ width:100%; height:110px; object-fit:cover }

  .collection img{ width:100%; height:140px; object-fit:cover; border-radius:8px }

  #imrMap{ width:100%; height:clamp(300px,50vw,520px); border-radius:10px }

  footer .card{ background:#071227; color:#fff }

  .btn-accent{ background:var(--accent); color:#fff; border:0 }

  button:focus, input:focus, select:focus{ outline:3px solid rgba(14,165,164,0.16); outline-offset:2px }

  img{ max-width:100%; height:auto; display:block }

  .badge-ai{ background:linear-gradient(90deg,#06b6d4,#06b6b7); color:#fff; padding:6px 10px; border-radius:999px; font-weight:700 }

  .imr-popup{ position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); display:none; align-items:center; justify-content:center; z-index:99999; }
  .imr-popup-content{ background:white; padding:16px; border-radius:10px; width:320px; text-align:center; }
  .imr-popup-buttons button{ width:90px; }

  .table-sm td, .table-sm th { padding: .45rem; font-size: .9rem; }

  /* NEW: Collaborative & Expense Styles */
  .collab-badge{ display:inline-block; background:var(--accent); color:#fff; padding:4px 10px; border-radius:999px; font-size:.85rem; margin-left:8px; }
  .expense-row{ display:flex; justify-content:space-between; align-items:center; padding:8px; border-bottom:1px solid #eee; margin:8px 0; }
  .expense-item{ flex:1; }
  .expense-amount{ font-weight:700; color:var(--accent); }
  .settlement-card{ background:#f0fdf4; border-left:4px solid var(--success); padding:12px; margin:8px 0; border-radius:6px; }
  .ai-loading{ animation:pulse 1.5s infinite; }
  @keyframes pulse{ 0%,100%{opacity:1} 50%{opacity:0.5} }
  .share-link-box{ background:#f3f4f6; padding:12px; border-radius:8px; display:flex; gap:8px; align-items:center; }
  .share-link-box input{ flex:1; border:1px solid #ddd; padding:6px; border-radius:4px; }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="logo">
      <img src="https://images.pexels.com/photos/21014/pexels-photo.jpg" alt="Guide360 logo">
      <div>
        <div style="font-weight:800; font-size:1.05rem;">Guide<span style="color:#2dd4bf">360</span></div>
        <div class="small-muted">Travel + Collab</div>
      </div>
    </div>

    <div class="menu-item" onclick="scrollToSection('home')"><i class="fa-solid fa-house"></i>&nbsp;<span class="menu-small">Home</span></div>
    <div class="menu-item" onclick="scrollToSection('trips')"><i class="fa-solid fa-suitcase-rolling"></i>&nbsp;<span class="menu-small">Trips</span></div>
    <div class="menu-item" onclick="scrollToSection('collab')"><i class="fa-solid fa-users"></i>&nbsp;<span class="menu-small">Collab</span></div>
    <div class="menu-item" onclick="scrollToSection('expenses')"><i class="fa-solid fa-money-bill"></i>&nbsp;<span class="menu-small">Expenses</span></div>
    <div class="menu-item" onclick="scrollToSection('imr')"><i class="fa-solid fa-route"></i>&nbsp;<span class="menu-small">IMR</span></div>

    <hr style="border-color:rgba(255,255,255,0.12)">

    <div class="menu-item" onclick="scrollToSection('about')"><i class="fa-solid fa-circle-info"></i>&nbsp;<span class="menu-small">About</span></div>
    <div class="menu-item" onclick="toggleDarkMode()"><i class="fa-solid fa-moon"></i>&nbsp;<span class="menu-small">Dark Mode</span></div>

    <div style="margin-top:16px;">
      <div class="small-muted">Account</div>
      <div style="display:flex; gap:8px; margin-top:8px;">
        <button class="btn btn-sm btn-light" onclick="openLogin()">Login</button>
        <button class="btn btn-sm btn-outline-light" onclick="openRegister()">Register</button>
      </div>
    </div>

    <div style="height:28px;"></div>
    <div class="small-muted">Guide360 — 100x Edition</div>
  </aside>

  <!-- MAIN -->
  <main class="main">

    <!-- Mobile menu toggle -->
    <button class="btn btn-dark d-lg-none mb-3" onclick="document.getElementById('sidebar').classList.toggle('open')" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>

    <!-- HOME HERO -->
    <section id="home" data-aos="fade-up">
      <div class="hero">
        <div class="hero-overlay">
          <h1 style="margin:0; font-size:clamp(1.4rem,4vw,2rem);">Plan Together <span class="small-muted" style="font-weight:600; font-size:.95rem;">AI Itineraries + Real-Time Collab</span></h1>
          <p class="small-muted" style="margin-top:6px;">Create a trip, invite friends, track expenses, settle instantly.</p>

          <div class="search-card mt-3" role="search" aria-label="Trip search">
            <input id="homeDest" type="text" class="form-control" placeholder="Destination (e.g., Goa)">
            <input id="homeStart" type="date" class="form-control" style="max-width:180px">
            <input id="homeEnd" type="date" class="form-control" style="max-width:180px">
            <button class="btn btn-accent" type="button" onclick="createTripFromHome()">
              <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Create with AI
            </button>
          </div>

          <div class="d-flex gap-2 mt-3 align-items-center">
            <div class="badge-ai">🤖 Claude AI + 👥 Real-time Collab + 💰 Smart Expenses</div>
          </div>
        </div>
      </div>
    </section>

    <!-- AI TRIPS -->
    <section id="trips" class="mt-4" data-aos="fade-up">
      <h3>Create Trip — Powered by Claude AI <span class="badge-ai">NEW</span></h3>
      <div class="card mt-2 p-3">
        <div class="alert alert-info" role="alert">
          <strong>⚙️ Setup Required:</strong> Add your <code>CLAUDE_API_KEY</code> in localStorage or use the demo mode (hardcoded results).
          <code style="display:block; margin-top:8px; padding:6px; background:#f3f4f6; border-radius:4px;">localStorage.setItem('CLAUDE_API_KEY', 'sk-ant-...')</code>
        </div>

        <form id="aiTripForm" onsubmit="return false;">
          <div class="row g-2">
            <div class="col-sm-6 col-md-3"><input name="dest" class="form-control" placeholder="Destination (e.g., Goa)"></div>
            <div class="col-sm-6 col-md-2"><input name="start" type="date" class="form-control"></div>
            <div class="col-sm-6 col-md-2"><input name="end" type="date" class="form-control"></div>
            <div class="col-sm-6 col-md-2"><select name="mood" class="form-select"><option value="relax">Relax</option><option value="adventure">Adventure</option><option value="culture">Culture</option><option value="food">Food</option></select></div>
            <div class="col-12 col-md-3"><button class="btn btn-accent w-100" id="genTripBtn">Generate with AI</button></div>
          </div>
        </form>
      </div>

      <div id="aiTripResult" class="mt-3"></div>

      <div class="card mt-3 p-3">
        <h5>My Trips</h5>
        <div id="savedTripsList"></div>
      </div>
    </section>

    <!-- COLLABORATIVE TRIPS -->
    <section id="collab" class="mt-4" data-aos="fade-up">
      <h3>Collaborate with Friends <span class="badge-ai">NEW</span></h3>
      <div class="card mt-2 p-3">
        <div class="row g-2 mb-3">
          <div class="col-md-8">
            <input id="collabTripSelect" class="form-control" placeholder="Select a trip to share..." list="tripList">
            <datalist id="tripList"></datalist>
          </div>
          <div class="col-md-4">
            <button class="btn btn-accent w-100" onclick="generateShareLink()">
              <i class="fa-solid fa-share"></i> Generate Share Link
            </button>
          </div>
        </div>

        <div id="shareLinkContainer" style="display:none;">
          <div class="share-link-box">
            <input type="text" id="shareLinkInput" readonly>
            <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard()">Copy</button>
          </div>
          <p class="small-muted mt-2">✅ Share this link with friends. They can view, comment, and suggest edits!</p>
        </div>

        <h5 class="mt-4">Recent Collaborators</h5>
        <div id="collabList" class="small-muted">No collaborators yet</div>
      </div>
    </section>

    <!-- EXPENSE TRACKING & SPLITTING -->
    <section id="expenses" class="mt-4" data-aos="fade-up">
      <h3>Smart Expense Splitting <span class="badge-ai">NEW</span></h3>
      <div class="card mt-2 p-3">
        <div class="row g-2 mb-3">
          <div class="col-md-2"><input id="expenseName" class="form-control" placeholder="Item (e.g., Hotel)"></div>
          <div class="col-md-2"><input id="expenseAmount" type="number" class="form-control" placeholder="₹ Amount"></div>
          <div class="col-md-2"><input id="expensePaidBy" class="form-control" placeholder="Paid by (name)"></div>
          <div class="col-md-2">
            <select id="expenseSplitAmong" class="form-select" multiple>
              <option>Alice</option>
              <option>Bob</option>
              <option>Carol</option>
              <option>David</option>
            </select>
          </div>
          <div class="col-md-2">
            <button class="btn btn-success w-100" onclick="addExpense()">
              <i class="fa-solid fa-plus"></i> Add
            </button>
          </div>
        </div>

        <h6>Expenses Log</h6>
        <div id="expensesList"></div>

        <h6 class="mt-4">Who Owes Whom?</h6>
        <div id="settlementList"></div>

        <button class="btn btn-danger mt-3 w-100" onclick="clearExpenses()">Clear All</button>
      </div>
    </section>

    <!-- IMR Map -->
    <section id="imr" class="mt-4" data-aos="fade-up">
      <h3>Instant Map Routes (IMR)</h3>
      <div class="card mt-2 p-3">
        <div class="row g-2">
          <div class="col-sm-8 col-md-8"><input id="imrPlaceSearch" class="form-control" placeholder="Search location (e.g., Taj Mahal)"></div>
          <div class="col-sm-4 col-md-4"><button class="btn btn-accent w-100" onclick="searchPlaceIMR()">Search & Add</button></div>
        </div>

        <div id="imrMap" class="mt-3"></div>

        <div class="d-flex gap-2 mt-3 flex-wrap align-items-center">
          <div class="small-muted">Click segments to change transport mode</div>
          <button class="btn btn-danger ms-auto" onclick="clearIMRMap()">Clear Map</button>
        </div>

        <div id="imrSegments" class="mt-3"></div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="mt-4" data-aos="fade-up">
      <h3>About Guide360 100x</h3>
      <div class="card mt-2 p-3">
        <p class="small-muted"><strong>✨ What's New:</strong></p>
        <ul class="small-muted">
          <li><strong>Claude AI Integration</strong> — Real itinerary generation (bring your own API key)</li>
          <li><strong>Collaborative Planning</strong> — Share trips, get real-time edits from friends</li>
          <li><strong>Smart Expense Splitting</strong> — Automatic settlement calculations, UPI-ready</li>
          <li><strong>Multi-Modal Routing</strong> — Auto-select transport mode (walk → flight) based on distance</li>
        </ul>
        <p class="small-muted mt-3">💡 Perfect for group trips. No backend needed — all data in localStorage.</p>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="mt-4">
      <div class="card p-3">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;">
          <div><strong>Guide360</strong> <div class="small-muted">Plan • Collab • Split 💜</div></div>
          <div class="small-muted">© 2024 — Hackathon 100x Edition</div>
        </div>
      </div>
    </footer>

  </main>

  <!-- LOGIN / REGISTER MODAL -->
  <div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header"><h5 id="authTitle">Login</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <form id="authForm" onsubmit="return false;">
            <div class="mb-2"><input id="authName" class="form-control" placeholder="Full name (for register)"></div>
            <div class="mb-2"><input id="authEmail" class="form-control" placeholder="Email"></div>
            <div class="mb-2"><input id="authPass" type="password" class="form-control" placeholder="Password"></div>
            <div class="d-flex justify-content-end gap-2">
              <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
              <button class="btn btn-accent" id="authActionBtn">Login</button>
            </div>
            <div id="authMsg" class="small-muted mt-2"></div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- POPUP FOR SELECTING MODE -->
  <div id="imrModePopup" class="imr-popup">
    <div class="imr-popup-content">
      <h6>Select Travel Mode</h6>
      <div id="imrModeButtons" class="imr-popup-buttons"></div>
      <button class="btn btn-sm btn-outline-danger mt-2" onclick="closeModePopup()">Close</button>
    </div>
  </div>

  <!-- SCRIPTS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
  // ============================
  // GUIDE360 — 100x Edition
  // ============================

  AOS.init({ duration: 700, once: true });

  const KEYS = {
    listings: 'g360_listings',
    trips: 'g360_aiTrips',
    users: 'g360_users',
    expenses: 'g360_expenses',
    collaborators: 'g360_collaborators',
    tempTrip: 'g360_tempTrip'
  };

  function uid(prefix='id'){ return prefix + '_' + Math.random().toString(36).slice(2,9); }
  function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }

  // ===========================
  // 1. CLAUDE AI INTEGRATION
  // ===========================
  async function callClaudeAI(dest, start, end, mood) {
    const apiKey = localStorage.getItem('CLAUDE_API_KEY');
    
    // If no API key, use demo mode
    if (!apiKey) {
      console.warn('No Claude API key. Using demo response.');
      return localAIGenerate(dest, start, end, mood, 'solo');
    }

    try {
      const payload = {
        model: 'claude-3-5-sonnet-20241022',
        max_tokens: 1000,
        messages: [{
          role: 'user',
          content: `Create a detailed ${mood} trip itinerary for ${dest} from ${start} to ${end}. 
          Return ONLY valid JSON (no markdown) with this exact structure:
          {
            "title": "string",
            "summary": "string",
            "budgetEstimate": number,
            "days": [{"day": "Day 1", "morning": "string", "afternoon": "string", "evening": "string"}],
            "hotels": [{"name": "string", "price": number}],
            "restaurants": [{"name": "string", "cuisine": "string", "price": number}],
            "activities": [{"name": "string", "duration": "string", "price": number}]
          }`
        }]
      };

      const res = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: {
          'x-api-key': apiKey,
          'anthropic-version': '2023-06-01',
          'content-type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      if (!res.ok) {
        const err = await res.text();
        throw new Error(`Claude API error: ${err}`);
      }

      const data = await res.json();
      const content = data.content[0].text.trim();
      
      // Extract JSON from markdown if needed
      const jsonMatch = content.match(/\{[\s\S]*\}/);
      if (!jsonMatch) throw new Error('Invalid Claude response');
      
      const parsed = JSON.parse(jsonMatch[0]);
      return {
        id: uid('trip'),
        ...parsed,
        created: new Date().toLocaleString(),
        isAI: true
      };
    } catch (err) {
      console.error('Claude API failed, using demo:', err);
      return localAIGenerate(dest, start, end, mood, 'solo');
    }
  }

  function localAIGenerate(dest, start, end, mood, pax) {
    const demoTrips = {
      'goa': {
        title: 'Goa Beach Paradise',
        summary: `A ${mood} ${pax} escape to sun, sand & sea`,
        budgetEstimate: 15000,
        days: [
          {day: 'Day 1', morning: 'Arrive & check-in', afternoon: 'Beach walk', evening: 'Dinner at beachside'},
          {day: 'Day 2', morning: 'Yoga on beach', afternoon: 'Scuba diving', evening: 'Sunset cruise'}
        ],
        hotels: [{name: 'Beach Resort', price: 5000}],
        restaurants: [{name: 'Café Delite', cuisine: 'Indian', price: 800}],
        activities: [{name: 'Scuba Dive', duration: '2h', price: 3000}]
      },
      'paris': {
        title: 'Paris Romance & Culture',
        summary: `A ${mood} ${pax} experience of art, history & cuisine`,
        budgetEstimate: 25000,
        days: [
          {day: 'Day 1', morning: 'Eiffel Tower', afternoon: 'Louvre Museum', evening: 'Seine dinner cruise'},
          {day: 'Day 2', morning: 'Notre-Dame', afternoon: 'Champs-Élysées', evening: 'Wine tasting'}
        ],
        hotels: [{name: 'Latin Quarter Hotel', price: 8000}],
        restaurants: [{name: 'Michelin Star Bistro', cuisine: 'French', price: 2500}],
        activities: [{name: 'Louvre Tour', duration: '3h', price: 1200}]
      }
    };

    const key = dest.toLowerCase();
    const demo = demoTrips[key] || {
      title: `${dest} Trip`,
      summary: `A ${mood} adventure for ${pax}`,
      budgetEstimate: 12000,
      days: [{day: 'Day 1', morning: 'Arrive', afternoon: 'Explore', evening: 'Relax'}],
      hotels: [{name: 'Local Hotel', price: 3000}],
      restaurants: [{name: 'Local Food', cuisine: 'Local', price: 500}],
      activities: [{name: 'City Tour', duration: '2h', price: 800}]
    };

    return {
      id: uid('trip'),
      ...demo,
      created: new Date().toLocaleString(),
      isAI: false
    };
  }

  async function generateTrip(event) {
    event && event.preventDefault && event.preventDefault();
    const form = document.getElementById('aiTripForm');
    const dest = (form.dest.value || '').trim();
    const start = form.start.value;
    const end = form.end.value;
    const mood = form.mood.value || 'relax';

    if (!dest) {
      alert('Please enter a destination');
      return;
    }

    const resultBox = document.getElementById('aiTripResult');
    resultBox.innerHTML = `<div class="card p-3 ai-loading"><div class="small-muted">🤖 Claude is thinking... generating your perfect itinerary...</div></div>`;

    try {
      const tripData = await callClaudeAI(dest, start, end, mood);
      renderTripResult(tripData);
      
      // Save trip
      const trips = JSON.parse(localStorage.getItem(KEYS.trips) || '[]');
      trips.push(tripData);
      localStorage.setItem(KEYS.trips, JSON.stringify(trips));
      loadSavedTrips();
      updateCollabTripList();
    } catch (err) {
      resultBox.innerHTML = `<div class="card p-3" style="background:#fee;border:1px solid #fcc;"><strong>❌ Error:</strong> ${escapeHtml(err.message)}</div>`;
    }
  }

  function renderTripResult(trip) {
    const resultBox = document.getElementById('aiTripResult');
    const daysHtml = (trip.days || []).map(d => `
      <div class="mt-2" style="border-left:4px solid var(--accent); padding-left:12px;">
        <strong>${escapeHtml(d.day)}</strong>
        <div class="small-muted">🌅 ${escapeHtml(d.morning || '—')} • 🌤️ ${escapeHtml(d.afternoon || '—')} • 🌙 ${escapeHtml(d.evening || '—')}</div>
      </div>
    `).join('');

    const hotelsHtml = (trip.hotels || []).map(h => `<div class="small-muted">🏨 ${escapeHtml(h.name)} — ₹${h.price}</div>`).join('');
    const restaurantsHtml = (trip.restaurants || []).map(r => `<div class="small-muted">🍽️ ${escapeHtml(r.name)} (${escapeHtml(r.cuisine)}) — ₹${r.price}</div>`).join('');
    const activitiesHtml = (trip.activities || []).map(a => `<div class="small-muted">🎯 ${escapeHtml(a.name)} (${escapeHtml(a.duration)}) — ₹${a.price}</div>`).join('');

    resultBox.innerHTML = `
      <div class="card p-3">
        <h5>${escapeHtml(trip.title)} <span class="badge-ai">${trip.isAI ? '🤖 AI' : 'Demo'}</span></h5>
        <div class="small-muted">📋 ${escapeHtml(trip.summary)}</div>
        <div style="margin-top:12px; padding:12px; background:#f0fdf4; border-radius:8px;">
          <strong style="color:var(--success);">💰 Budget: ₹${trip.budgetEstimate}</strong>
        </div>
        
        <h6 class="mt-3">📅 Itinerary</h6>
        ${daysHtml}

        <h6 class="mt-3">🏨 Hotels</h6>
        ${hotelsHtml || '<div class="small-muted">—</div>'}

        <h6 class="mt-3">🍽️ Restaurants</h6>
        ${restaurantsHtml || '<div class="small-muted">—</div>'}

        <h6 class="mt-3">🎯 Activities</h6>
        ${activitiesHtml || '<div class="small-muted">—</div>'}

        <div class="mt-3" style="display:flex; gap:8px;">
          <button class="btn btn-sm btn-accent" onclick="shareThisTrip('${trip.id}')">
            <i class="fa-solid fa-share"></i> Share
          </button>
          <button class="btn btn-sm btn-outline-secondary" onclick="deleteTrip('${trip.id}')">
            <i class="fa-solid fa-trash"></i> Delete
          </button>
        </div>
      </div>
    `;
  }

  function createTripFromHome() {
    try {
      const destEl = document.getElementById('homeDest');
      const startEl = document.getElementById('homeStart');
      const endEl = document.getElementById('homeEnd');
      
      const dest = destEl ? destEl.value.trim() : '';
      const start = startEl ? startEl.value : '';
      const end = endEl ? endEl.value : '';

      if (!dest) {
        alert('Please enter a destination');
        if (destEl) destEl.focus();
        return;
      }

      scrollToSection('trips');
      setTimeout(() => {
        const aiForm = document.getElementById('aiTripForm');
        if (aiForm) {
          if (aiForm.dest) aiForm.dest.value = dest;
          if (aiForm.start) aiForm.start.value = start;
          if (aiForm.end) aiForm.end.value = end;
        }
        if (typeof generateTrip === 'function') {
          try { generateTrip(); } catch (e) { console.warn('generateTrip failed', e); }
        }
      }, 420);
    } catch (err) {
      console.error('createTripFromHome error', err);
      alert('Error creating trip');
    }
  }

  function loadSavedTrips() {
    const trips = JSON.parse(localStorage.getItem(KEYS.trips) || '[]');
    const container = document.getElementById('savedTripsList');
    container.innerHTML = '';

    if (!trips.length) {
      container.innerHTML = '<div class="small-muted">No trips yet. Create one above!</div>';
      return;
    }

    trips.forEach(t => {
      container.insertAdjacentHTML('beforeend', `
        <div class="card p-2 mt-2" style="background:var(--card); border:1px solid #eee;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
              <strong>${escapeHtml(t.title || t.dest || 'Trip')}</strong>
              <div class="small-muted">₹${t.budgetEstimate || '—'} • ${escapeHtml(t.created || '')}</div>
            </div>
            <div>
              <button class="btn btn-sm btn-accent me-1" onclick="shareThisTrip('${t.id}')">
                <i class="fa-solid fa-share"></i>
              </button>
              <button class="btn btn-sm btn-danger" onclick="deleteTrip('${t.id}')">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
        </div>
      `);
    });
  }

  function deleteTrip(id) {
    if (!confirm('Delete this trip?')) return;
    let trips = JSON.parse(localStorage.getItem(KEYS.trips) || '[]');
    trips = trips.filter(t => t.id !== id);
    localStorage.setItem(KEYS.trips, JSON.stringify(trips));
    loadSavedTrips();
    updateCollabTripList();
  }

  // ===========================
  // 2. COLLABORATIVE TRIPS
  // ===========================
  function updateCollabTripList() {
    const trips = JSON.parse(localStorage.getItem(KEYS.trips) || '[]');
    const datalist = document.getElementById('tripList');
    datalist.innerHTML = '';
    trips.forEach(t => {
      datalist.insertAdjacentHTML('beforeend', `<option value="${escapeHtml(t.title || t.id)}">`);
    });
  }

  function generateShareLink() {
    const tripSelect = document.getElementById('collabTripSelect').value;
    if (!tripSelect) {
      alert('Please select a trip');
      return;
    }

    const trips = JSON.parse(localStorage.getItem(KEYS.trips) || '[]');
    const trip = trips.find(t => t.title === tripSelect || t.id === tripSelect);
    if (!trip) {
      alert('Trip not found');
      return;
    }

    const shareKey = uid('share');
    const collaborators = JSON.parse(localStorage.getItem(KEYS.collaborators) || '{}');
    collaborators[shareKey] = { tripId: trip.id, createdAt: new Date().toLocaleString(), viewers: [] };
    localStorage.setItem(KEYS.collaborators, JSON.stringify(collaborators));

    const baseUrl = window.location.origin + window.location.pathname;
    const shareLink = `${baseUrl}?collab=${shareKey}`;

    document.getElementById('shareLinkInput').value = shareLink;
    document.getElementById('shareLinkContainer').style.display = 'block';
  }

  function copyToClipboard() {
    const input = document.getElementById('shareLinkInput');
    input.select();
    document.execCommand('copy');
    alert('✅ Link copied! Share it with your friends.');
  }

  function shareThisTrip(tripId) {
    document.getElementById('collabTripSelect').value = JSON.parse(localStorage.getItem(KEYS.trips) || '[]').find(t => t.id === tripId)?.title || '';
    generateShareLink();
    scrollToSection('collab');
  }

  // ===========================
  // 3. EXPENSE SPLITTING
  // ===========================
  function addExpense() {
    const name = document.getElementById('expenseName').value.trim();
    const amount = parseFloat(document.getElementById('expenseAmount').value);
    const paidBy = document.getElementById('expensePaidBy').value.trim();
    const splitOptions = Array.from(document.getElementById('expenseSplitAmong').selectedOptions).map(o => o.value);

    if (!name || !amount || !paidBy || splitOptions.length === 0) {
      alert('Please fill all fields and select who to split with');
      return;
    }

    const expenses = JSON.parse(localStorage.getItem(KEYS.expenses) || '[]');
    expenses.push({ id: uid('exp'), name, amount, paidBy, splitAmong: splitOptions, date: new Date().toLocaleString() });
    localStorage.setItem(KEYS.expenses, JSON.stringify(expenses));

    document.getElementById('expenseName').value = '';
    document.getElementById('expenseAmount').value = '';
    document.getElementById('expensePaidBy').value = '';

    renderExpenses();
    calculateSettlements();
  }

  function renderExpenses() {
    const expenses = JSON.parse(localStorage.getItem(KEYS.expenses) || '[]');
    const container = document.getElementById('expensesList');
    container.innerHTML = '';

    expenses.forEach(exp => {
      container.insertAdjacentHTML('beforeend', `
        <div class="expense-row">
          <div class="expense-item">
            <strong>${escapeHtml(exp.name)}</strong>
            <div class="small-muted">Paid by ${escapeHtml(exp.paidBy)} • Split among ${exp.splitAmong.join(', ')}</div>
          </div>
          <div class="expense-amount">₹${exp.amount}</div>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteExpense('${exp.id}')">✕</button>
        </div>
      `);
    });

    if (!expenses.length) {
      container.innerHTML = '<div class="small-muted">No expenses yet</div>';
    }
  }

  function deleteExpense(id) {
    let expenses = JSON.parse(localStorage.getItem(KEYS.expenses) || '[]');
    expenses = expenses.filter(e => e.id !== id);
    localStorage.setItem(KEYS.expenses, JSON.stringify(expenses));
    renderExpenses();
    calculateSettlements();
  }

  function calculateSettlements() {
    const expenses = JSON.parse(localStorage.getItem(KEYS.expenses) || '[]');
    const balances = {};

    expenses.forEach(exp => {
      if (!balances[exp.paidBy]) balances[exp.paidBy] = 0;
      balances[exp.paidBy] += exp.amount;

      const perPerson = exp.amount / exp.splitAmong.length;
      exp.splitAmong.forEach(person => {
        if (!balances[person]) balances[person] = 0;
        balances[person] -= perPerson;
      });
    });

    const settlements = [];
    const debtors = Object.entries(balances).filter(([, amt]) => amt < 0);
    const creditors = Object.entries(balances).filter(([, amt]) => amt > 0);

    debtors.forEach(([debtor, debt]) => {
      creditors.forEach(([creditor, credit]) => {
        if (credit > 0 && debt < 0) {
          const amount = Math.min(Math.abs(debt), credit);
          settlements.push({ from: debtor, to: creditor, amount: Math.round(amount * 100) / 100 });
          balances[debtor] += amount;
          balances[creditor] -= amount;
        }
      });
    });

    const container = document.getElementById('settlementList');
    container.innerHTML = '';

    if (settlements.length === 0) {
      container.innerHTML = '<div class="small-muted">No outstanding balances!</div>';
      return;
    }

    settlements.forEach(s => {
      container.insertAdjacentHTML('beforeend', `
        <div class="settlement-card">
          <strong>${escapeHtml(s.from)}</strong> owes <strong>${escapeHtml(s.to)}</strong> <span style="color:var(--success); font-weight:700;">₹${s.amount}</span>
          <button class="btn btn-xs btn-outline-success ms-2" onclick="alert('💬 Share UPI/Venmo link with ' + '${s.from}')">Send Payment Link</button>
        </div>
      `);
    });
  }

  function clearExpenses() {
    if (!confirm('Clear all expenses?')) return;
    localStorage.removeItem(KEYS.expenses);
    renderExpenses();
    calculateSettlements();
  }

  // ===========================
  // IMR multi-mode routing
  // ===========================
  let imrMap, imrMarkers = [], imrRouteSegments = [], activeSegmentIndex = null;

  const transportModes = {
    air: { label: "✈ Air", speed: 800 },
    train: { label: "🚆 Train", speed: 90 },
    bus: { label: "🚌 Bus", speed: 50 },
    car: { label: "🚗 Car", speed: 60 },
    bike: { label: "🛵 Bike", speed: 40 },
    cycle: { label: "🚴 Cycle", speed: 18 },
    walk: { label: "🚶 Walk", speed: 5 }
  };

  function autoSelectMode(km) {
    if (km > 300) return "air";
    if (km > 50) return "train";
    if (km > 10) return "car";
    if (km > 5) return "bus";
    if (km > 1) return "bike";
    return "walk";
  }

  function calcDistance(lat1, lon1, lat2, lon2) {
    const R = 6371;
    const toRad = v => v * Math.PI / 180;
    const dLat = toRad(lat2 - lat1);
    const dLon = toRad(lon2 - lon1);
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
    return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
  }

  function initIMR() {
    if (document.getElementById('imrMap').innerHTML) return; // Already init
    imrMap = L.map('imrMap').setView([20.5937, 78.9629], 5);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(imrMap);
    imrMap.on('click', e => addIMRPoint(e.latlng.lat, e.latlng.lng));
    window.addEventListener('resize', () => { setTimeout(() => imrMap.invalidateSize(), 300); });
  }

  function addIMRPoint(lat, lng) {
    const mk = L.marker([lat, lng], { draggable: true }).addTo(imrMap);
    mk.on('dragend', updateRoute);
    imrMarkers.push(mk);
    updateRoute();
  }

  async function searchPlaceIMR() {
    const query = document.getElementById('imrPlaceSearch').value.trim();
    if (!query) { alert('Enter a place name.'); return; }
    
    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`);
      const data = await res.json();
      if (!data || !data.length) { alert('Location not found.'); return; }
      const loc = data[0];
      addIMRPoint(parseFloat(loc.lat), parseFloat(loc.lon));
      imrMap.setView([loc.lat, loc.lon], 12);
    } catch (err) { alert('Search failed.'); }
  }

  function updateRoute() {
    imrRouteSegments.forEach(seg => imrMap.removeLayer(seg.line));
    imrRouteSegments = [];
    if (imrMarkers.length < 2) {
      document.getElementById('imrSegments').innerHTML = `<div class="small-muted">Add at least 2 points</div>`;
      return;
    }

    const segments = [];
    let totalDistance = 0, totalTime = 0;

    for (let i = 0; i < imrMarkers.length - 1; i++) {
      const A = imrMarkers[i].getLatLng();
      const B = imrMarkers[i + 1].getLatLng();
      const km = calcDistance(A.lat, A.lng, B.lat, B.lng);
      const mode = autoSelectMode(km);
      const speed = transportModes[mode].speed;
      const hours = km / speed;
      totalDistance += km;
      totalTime += hours;
      const line = L.polyline([A, B], { color: "#0ea5a4", weight: 4 }).addTo(imrMap);
      line.on("click", () => openModePopup(i));
      segments.push({ from: i + 1, to: i + 2, km, time: hours, mode, line });
    }

    imrRouteSegments = segments;
    renderSegmentTable(segments, totalDistance, totalTime);
  }

  function renderSegmentTable(segments, totalDist, totalTime) {
    let html = `<table class="table table-sm table-bordered"><tr><th>Segment</th><th>Mode</th><th>Distance</th><th>Time</th></tr>`;
    segments.forEach(s => {
      const h = Math.floor(s.time);
      const m = Math.round((s.time - h) * 60);
      html += `<tr><td>${s.from} → ${s.to}</td><td>${transportModes[s.mode].label}</td><td>${s.km.toFixed(2)} km</td><td>${h}h ${m}m</td></tr>`;
    });
    const H = Math.floor(totalTime);
    const M = Math.round((totalTime - H) * 60);
    html += `<tr class="table-dark"><td colspan="2"><strong>Total</strong></td><td><strong>${totalDist.toFixed(2)} km</strong></td><td><strong>${H}h ${M}m</strong></td></tr></table>`;
    document.getElementById('imrSegments').innerHTML = html;
  }

  function openModePopup(index) {
    activeSegmentIndex = index;
    let btnHTML = "";
    Object.keys(transportModes).forEach(mode => {
      btnHTML += `<button class="btn btn-sm btn-primary m-1" onclick="overrideSegmentMode('${mode}')">${transportModes[mode].label}</button>`;
    });
    document.getElementById('imrModeButtons').innerHTML = btnHTML;
    document.getElementById('imrModePopup').style.display = "flex";
  }

  function closeModePopup() { document.getElementById('imrModePopup').style.display = "none"; }

  function overrideSegmentMode(mode) {
    if (imrRouteSegments[activeSegmentIndex]) imrRouteSegments[activeSegmentIndex].mode = mode;
    closeModePopup();
    updateRoute();
  }

  function clearIMRMap() {
    if (!confirm('Clear all map points and routes?')) return;
    imrMarkers.forEach(m => imrMap.removeLayer(m));
    imrRouteSegments.forEach(s => imrMap.removeLayer(s.line));
    imrMarkers = [];
    imrRouteSegments = [];
    document.getElementById('imrSegments').innerHTML = `<div class="small-muted">Map cleared.</div>`;
  }

  // ===========================
  // Auth & UI
  // ===========================
  function openLogin() {
    const modal = new bootstrap.Modal(document.getElementById('authModal'));
    document.getElementById('authTitle').innerText = 'Login';
    document.getElementById('authName').style.display = 'none';
    document.getElementById('authActionBtn').innerText = 'Login';
    modal.show();
  }

  function openRegister() {
    const modal = new bootstrap.Modal(document.getElementById('authModal'));
    document.getElementById('authTitle').innerText = 'Register';
    document.getElementById('authName').style.display = 'block';
    document.getElementById('authActionBtn').innerText = 'Register';
    modal.show();
  }

  function scrollToSection(id) {
    const el = document.getElementById(id);
    if (!el) { window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
    const top = el.getBoundingClientRect().top + window.scrollY - 80;
    window.scrollTo({ top, behavior: 'smooth' });
    const sb = document.getElementById('sidebar');
    if (sb && sb.classList.contains('open')) sb.classList.remove('open');
  }

  function toggleDarkMode() {
    const html = document.documentElement;
    const isDark = html.getAttribute('data-theme') === 'dark';
    html.setAttribute('data-theme', isDark ? 'light' : 'dark');
    localStorage.setItem('g360_theme', isDark ? 'light' : 'dark');
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    loadSavedTrips();
    updateCollabTripList();
    renderExpenses();
    calculateSettlements();
    initIMR();

    const genBtn = document.getElementById('genTripBtn');
    if (genBtn) genBtn.addEventListener('click', generateTrip);

    // Restore theme
    const savedTheme = localStorage.getItem('g360_theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);

    // Check for share link
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('collab')) {
      alert('👥 Welcome! You\'ve been invited to collaborate on a trip. View it in the Collab section.');
    }

    setTimeout(() => { if (imrMap) imrMap.invalidateSize(); }, 500);
  });

  // Expose functions
  window.generateTrip = generateTrip;
  window.createTripFromHome = createTripFromHome;
  window.deleteTrip = deleteTrip;
  window.shareThisTrip = shareThisTrip;
  window.generateShareLink = generateShareLink;
  window.copyToClipboard = copyToClipboard;
  window.addExpense = addExpense;
  window.deleteExpense = deleteExpense;
  window.clearExpenses = clearExpenses;
  window.scrollToSection = scrollToSection;
  window.toggleDarkMode = toggleDarkMode;
  window.openLogin = openLogin;
  window.openRegister = openRegister;
  window.addIMRPoint = addIMRPoint;
  window.searchPlaceIMR = searchPlaceIMR;
  window.clearIMRMap = clearIMRMap;
  window.openModePopup = openModePopup;
  window.closeModePopup = closeModePopup;
  window.overrideSegmentMode = overrideSegmentMode;
  </script>

